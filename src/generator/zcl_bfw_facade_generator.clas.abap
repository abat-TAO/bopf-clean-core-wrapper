"! Builds the model of a typed facade class for a classic BOPF business object from a selection: one method per
"! selected node, association, alternative key, action or query, each delegating to ZIF_BFW_BUSINESS_OBJECT.
"! ZCL_BFW_FACADE_WRITER writes the model; problems in the selection are returned as errors, not raised.
CLASS zcl_bfw_facade_generator DEFINITION
  PUBLIC
  FINAL
  CREATE PUBLIC.

  PUBLIC SECTION.
    "! First line of the method GET_SELECTION of every generated facade
    CONSTANTS marker TYPE string VALUE `" Generated by ZBFW_FACADE_GENERATOR: do not change, regenerate instead`.

    CONSTANTS:
      "! Kinds of selection entries
      BEGIN OF kinds,
        node            TYPE string VALUE `node`,
        writable_node   TYPE string VALUE `writable_node`,
        association     TYPE string VALUE `association`,
        alternative_key TYPE string VALUE `alternative_key`,
        action          TYPE string VALUE `action`,
        query           TYPE string VALUE `query`,
      END OF kinds.

    CONSTANTS:
      BEGIN OF directions,
        importing TYPE c LENGTH 1 VALUE 'I',
        exporting TYPE c LENGTH 1 VALUE 'E',
        changing  TYPE c LENGTH 1 VALUE 'C',
        returning TYPE c LENGTH 1 VALUE 'R',
      END OF directions.

    TYPES:
      "! One selection line: kind name [= alias], e.g. association ROOT.ITEM = items
      BEGIN OF selection_entry,
        kind  TYPE string,
        name  TYPE string,
        alias TYPE string,
      END OF selection_entry,
      selection_entries TYPE STANDARD TABLE OF selection_entry WITH EMPTY KEY.

    TYPES:
      BEGIN OF method_parameter,
        name          TYPE string,
        direction     TYPE c LENGTH 1,
        type_name     TYPE string,
        is_optional   TYPE abap_bool,
        default_value TYPE string,
      END OF method_parameter,
      method_parameters TYPE STANDARD TABLE OF method_parameter WITH EMPTY KEY.

    TYPES:
      BEGIN OF facade_method,
        name       TYPE string,
        is_static  TYPE abap_bool,
        parameters TYPE method_parameters,
        "! Method body, indented for the method frame of the class builder
        source     TYPE string_table,
      END OF facade_method,
      facade_methods TYPE STANDARD TABLE OF facade_method WITH EMPTY KEY.

    TYPES:
      "! Private instance attribute, typed TYPE REF TO the interface
      BEGIN OF facade_attribute,
        name           TYPE string,
        interface_name TYPE string,
      END OF facade_attribute,
      facade_attributes TYPE STANDARD TABLE OF facade_attribute WITH EMPTY KEY.

    TYPES:
      BEGIN OF facade,
        class_name      TYPE string,
        description     TYPE string,
        business_object TYPE string,
        attributes      TYPE facade_attributes,
        methods         TYPE facade_methods,
      END OF facade.

    "! @parameter business_object | Name of the classic BOPF business object, e.g. /BOBF/DEMO_SALES_ORDER
    "! @parameter selection       | One line per entry, see PARSE_SELECTION
    "! @parameter errors          | Problems in the selection; FACADE is complete only without errors
    METHODS build
      IMPORTING
        business_object TYPE csequence
        class_name      TYPE csequence
        selection       TYPE string_table
      EXPORTING
        facade          TYPE facade
        errors          TYPE string_table.

    "! Splits selection lines of the form kind name [= alias] into entries. Kind and alias become lower case, the
    "! name upper case. Associations, alternative keys, actions and queries are named node.name.
    METHODS parse_selection
      IMPORTING
        selection TYPE string_table
      EXPORTING
        entries   TYPE selection_entries
        errors    TYPE string_table.

    "! Selection lines from the source of the method GET_SELECTION of a generated facade
    METHODS get_selection_from_source
      IMPORTING
        source        TYPE string_table
      RETURNING
        VALUE(result) TYPE string_table.

    "! Whether the source of a method GET_SELECTION comes from this generator
    METHODS is_generated_source
      IMPORTING
        source        TYPE string_table
      RETURNING
        VALUE(result) TYPE abap_bool.

  PROTECTED SECTION.
  PRIVATE SECTION.
    TYPES:
      BEGIN OF call_parameter,
        keyword TYPE string,
        name    TYPE string,
        value   TYPE string,
      END OF call_parameter,
      call_parameters TYPE STANDARD TABLE OF call_parameter WITH EMPTY KEY.

    CONSTANTS maximum_name_length TYPE i VALUE 30.
    CONSTANTS engine_interface TYPE string VALUE `ZIF_BFW_BUSINESS_OBJECT`.
    CONSTANTS key_table_type TYPE string VALUE `/BOBF/T_FRW_KEY`.
    CONSTANTS messages_type TYPE string VALUE `ZIF_BFW_BUSINESS_OBJECT=>MESSAGES`.
    CONSTANTS selection_parameters_type TYPE string VALUE `ZIF_BFW_BUSINESS_OBJECT=>SELECTION_PARAMETERS`.
    CONSTANTS sorting_type TYPE string VALUE `ZIF_BFW_BUSINESS_OBJECT=>SORTING`.
    CONSTANTS paging_type TYPE string VALUE `ZIF_BFW_BUSINESS_OBJECT=>PAGING`.
    CONSTANTS field_names_type TYPE string VALUE `ZIF_BFW_BUSINESS_OBJECT=>FIELD_NAMES`.
    "! Type of action results that the configuration defines only by their structure
    CONSTANTS generic_rows_type TYPE string VALUE `INDEX TABLE`.
    CONSTANTS failed_keys_declaration TYPE string VALUE `    DATA engine_failed_keys TYPE zif_bfw_business_object=>keys.`.
    CONSTANTS failed_keys_conversion TYPE string VALUE `    failed_keys = CORRESPONDING #( engine_failed_keys ).`.

    DATA metadata TYPE REF TO zcl_bfw_metadata.

    METHODS get_constructor
      IMPORTING
        business_object TYPE string
      RETURNING
        VALUE(result)   TYPE facade_method.

    METHODS get_selection_method
      IMPORTING
        entries       TYPE selection_entries
      RETURNING
        VALUE(result) TYPE facade_method.

    "! Adds the methods of one entry to the facade, or its problem to the errors
    METHODS add_entry_methods
      IMPORTING
        entry  TYPE selection_entry
      CHANGING
        facade TYPE facade
        errors TYPE string_table.

    METHODS get_entry_methods
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_methods.

    METHODS get_node_read
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_method.

    METHODS get_node_writes
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_methods.

    METHODS get_association_read
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_method.

    METHODS get_alternative_key_read
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_method.

    METHODS get_query
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_method.

    METHODS get_action_execution
      IMPORTING
        entry         TYPE selection_entry
      RETURNING
        VALUE(result) TYPE facade_method.

    "! The part of the method name after the verb: the alias, otherwise GENERATED_SUBJECT
    METHODS get_subject
      IMPORTING
        entry             TYPE selection_entry
        generated_subject TYPE string
      RETURNING
        VALUE(result)     TYPE string.

    "! Lower case, dots replaced by underscores
    METHODS to_subject
      IMPORTING
        name          TYPE string
      RETURNING
        VALUE(result) TYPE string.

    "! Splits node.member at the last dot
    METHODS split_member
      IMPORTING
        name   TYPE string
      EXPORTING
        node   TYPE string
        member TYPE string.

    METHODS format_call
      IMPORTING
        call          TYPE string
        parameters    TYPE call_parameters
      RETURNING
        VALUE(result) TYPE string_table.

    "! Source of a write call that returns the failed keys of the engine as /BOBF/T_FRW_KEY
    METHODS add_failed_keys_conversion
      IMPORTING
        call_lines    TYPE string_table
      RETURNING
        VALUE(result) TYPE string_table.

    METHODS close_statement
      CHANGING
        statement_lines TYPE string_table.

    METHODS check_method_names
      IMPORTING
        checked_methods TYPE facade_methods
      RETURNING
        VALUE(result)   TYPE string_table.
ENDCLASS.



CLASS zcl_bfw_facade_generator IMPLEMENTATION.

  METHOD build.
    CLEAR: facade, errors.
    parse_selection( EXPORTING selection = selection
                     IMPORTING entries   = DATA(entries)
                               errors    = errors ).
    IF entries IS INITIAL AND errors IS INITIAL.
      INSERT `The selection is empty` INTO TABLE errors.
    ENDIF.
    DATA(upper_class_name) = to_upper( condense( class_name ) ).
    IF upper_class_name IS INITIAL OR strlen( upper_class_name ) > maximum_name_length.
      INSERT |Class name { upper_class_name } must have 1 to { maximum_name_length } characters| INTO TABLE errors.
    ENDIF.
    IF errors IS NOT INITIAL.
      RETURN.
    ENDIF.

    DATA(upper_business_object) = to_upper( condense( business_object ) ).
    TRY.
        " The factory refuses business objects that are not classic BOPF
        zcl_bfw_factory=>get_business_object( upper_business_object ).
        metadata = NEW #( /bobf/cl_frw_factory=>get_configuration(
                            /bobf/cl_frw_factory=>query_bo( CONV #( upper_business_object ) ) ) ).
      CATCH zcx_bfw_access /bobf/cx_frw /bobf/cx_frw_contrct_violation INTO DATA(business_object_error).
        INSERT business_object_error->get_text( ) INTO TABLE errors.
        RETURN.
    ENDTRY.

    facade = VALUE #( class_name      = upper_class_name
                      description     = |Generated facade of { upper_business_object }|
                      business_object = upper_business_object
                      attributes      = VALUE #( ( name           = `ENGINE`
                                                   interface_name = engine_interface ) )
                      methods         = VALUE #( ( get_constructor( upper_business_object ) )
                                                 ( get_selection_method( entries ) ) ) ).
    LOOP AT entries ASSIGNING FIELD-SYMBOL(<entry>).
      add_entry_methods( EXPORTING entry  = <entry>
                         CHANGING  facade = facade
                                   errors = errors ).
    ENDLOOP.
    INSERT LINES OF check_method_names( facade-methods ) INTO TABLE errors.
  ENDMETHOD.


  METHOD add_entry_methods.
    TRY.
        INSERT LINES OF get_entry_methods( entry ) INTO TABLE facade-methods.
      CATCH zcx_bfw_access INTO DATA(error).
        INSERT |{ entry-kind } { entry-name }: { error->get_text( ) }| INTO TABLE errors.
    ENDTRY.
  ENDMETHOD.


  METHOD parse_selection.
    DATA kind TYPE string.
    DATA name TYPE string.
    DATA alias TYPE string.

    CLEAR: entries, errors.
    LOOP AT selection ASSIGNING FIELD-SYMBOL(<line>).
      IF condense( <line> ) = ``.
        CONTINUE.
      ENDIF.
      CLEAR: kind, name, alias.
      FIND FIRST OCCURRENCE OF PCRE `^\s*(\w+)\s+([\w/.]+)\s*(?:=\s*(\w+))?\s*$` IN <line> SUBMATCHES kind name alias.
      IF sy-subrc <> 0.
        INSERT |Line "{ <line> }" does not have the form: kind name [= alias]| INTO TABLE errors.
        CONTINUE.
      ENDIF.

      kind = to_lower( kind ).
      name = to_upper( name ).
      alias = to_lower( alias ).
      IF kind <> kinds-node AND kind <> kinds-writable_node AND kind <> kinds-association
          AND kind <> kinds-alternative_key AND kind <> kinds-action AND kind <> kinds-query.
        INSERT |Line "{ <line> }": unknown kind { kind }| INTO TABLE errors.
        CONTINUE.
      ENDIF.
      IF kind <> kinds-node AND kind <> kinds-writable_node AND name NS `.`.
        INSERT |Line "{ <line> }": { kind } needs a name of the form node.name| INTO TABLE errors.
        CONTINUE.
      ENDIF.
      INSERT VALUE #( kind  = kind
                      name  = name
                      alias = alias ) INTO TABLE entries.
    ENDLOOP.
  ENDMETHOD.


  METHOD get_selection_from_source.
    DATA selection_line TYPE string.

    LOOP AT source ASSIGNING FIELD-SYMBOL(<line>).
      CLEAR selection_line.
      FIND FIRST OCCURRENCE OF PCRE '`([^`]*)`' IN <line> SUBMATCHES selection_line.
      IF sy-subrc = 0.
        INSERT selection_line INTO TABLE result.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.


  METHOD is_generated_source.
    IF source IS INITIAL.
      RETURN.
    ENDIF.
    result = xsdbool( condense( source[ 1 ] ) = marker ).
  ENDMETHOD.


  METHOD get_constructor.
    result = VALUE #(
      name   = `CONSTRUCTOR`
      source = VALUE #( ( |    engine = zcl_bfw_factory=>get_business_object( `{ business_object }` ).| ) ) ).
  ENDMETHOD.


  METHOD get_selection_method.
    DATA(selection_lines) = VALUE string_table( FOR entry IN entries
                                                ( COND #( WHEN entry-alias IS INITIAL
                                                          THEN |{ entry-kind } { entry-name }|
                                                          ELSE |{ entry-kind } { entry-name } = { entry-alias }| ) ) ).
    result = VALUE #( name       = `GET_SELECTION`
                      is_static  = abap_true
                      parameters = VALUE #( ( name      = `RESULT`
                                              direction = directions-returning
                                              type_name = `STRING_TABLE` ) )
                      source     = VALUE #( ( |    { marker }| ) ) ).
    LOOP AT selection_lines ASSIGNING FIELD-SYMBOL(<selection_line>).
      INSERT COND #( WHEN sy-tabix = 1
                     THEN |    result = VALUE #( ( `{ <selection_line> }` )|
                     ELSE |                      ( `{ <selection_line> }` )| ) INTO TABLE result-source.
    ENDLOOP.
    close_statement( CHANGING statement_lines = result-source ).
  ENDMETHOD.


  METHOD get_entry_methods.
    CASE entry-kind.
      WHEN kinds-node.
        result = VALUE #( ( get_node_read( entry ) ) ).
      WHEN kinds-writable_node.
        result = get_node_writes( entry ).
      WHEN kinds-association.
        result = VALUE #( ( get_association_read( entry ) ) ).
      WHEN kinds-alternative_key.
        result = VALUE #( ( get_alternative_key_read( entry ) ) ).
      WHEN kinds-action.
        result = VALUE #( ( get_action_execution( entry ) ) ).
      WHEN kinds-query.
        result = VALUE #( ( get_query( entry ) ) ).
    ENDCASE.
  ENDMETHOD.


  METHOD get_node_read.
    DATA(node) = metadata->get_node( entry-name ).
    DATA(subject) = get_subject( entry             = entry
                                 generated_subject = to_subject( entry-name ) ).
    result = VALUE #(
      name       = to_upper( |read_{ subject }| )
      parameters = VALUE #( ( name      = `KEYS`
                              direction = directions-importing
                              type_name = key_table_type )
                            ( name      = `RESULT`
                              direction = directions-returning
                              type_name = node-table_type->get_relative_name( ) ) )
      source     = format_call( call       = `engine->read`
                                parameters = VALUE #( ( keyword = `EXPORTING`
                                                        name    = `node`
                                                        value   = |`{ entry-name }`| )
                                                      ( keyword = `EXPORTING`
                                                        name    = `keys`
                                                        value   = `CORRESPONDING #( keys )` )
                                                      ( keyword = `IMPORTING`
                                                        name    = `rows`
                                                        value   = `result` ) ) ) ).
  ENDMETHOD.


  METHOD get_node_writes.
    DATA(node) = metadata->get_node( entry-name ).
    DATA(subject) = get_subject( entry             = entry
                                 generated_subject = to_subject( entry-name ) ).
    DATA(table_type) = node-table_type->get_relative_name( ).
    DATA(node_literal) = |`{ entry-name }`|.

    INSERT VALUE #(
      name       = to_upper( |create_{ subject }| )
      parameters = VALUE #( ( name      = `FAILED_KEYS`
                              direction = directions-exporting
                              type_name = key_table_type )
                            ( name      = `MESSAGES`
                              direction = directions-exporting
                              type_name = messages_type )
                            ( name      = `ROWS`
                              direction = directions-changing
                              type_name = table_type ) )
      source     = add_failed_keys_conversion( format_call(
                                                 call       = `engine->create`
                                                 parameters = VALUE #( ( keyword = `EXPORTING`
                                                                         name    = `node`
                                                                         value   = node_literal )
                                                                       ( keyword = `IMPORTING`
                                                                         name    = `failed_keys`
                                                                         value   = `engine_failed_keys` )
                                                                       ( keyword = `IMPORTING`
                                                                         name    = `messages`
                                                                         value   = `messages` )
                                                                       ( keyword = `CHANGING`
                                                                         name    = `rows`
                                                                         value   = `rows` ) ) ) ) )
           INTO TABLE result.

    INSERT VALUE #(
      name       = to_upper( |update_{ subject }| )
      parameters = VALUE #( ( name      = `ROWS`
                              direction = directions-importing
                              type_name = table_type )
                            ( name        = `CHANGED_FIELDS`
                              direction   = directions-importing
                              type_name   = field_names_type
                              is_optional = abap_true )
                            ( name      = `FAILED_KEYS`
                              direction = directions-exporting
                              type_name = key_table_type )
                            ( name      = `MESSAGES`
                              direction = directions-exporting
                              type_name = messages_type ) )
      source     = add_failed_keys_conversion( format_call(
                                                 call       = `engine->update`
                                                 parameters = VALUE #( ( keyword = `EXPORTING`
                                                                         name    = `node`
                                                                         value   = node_literal )
                                                                       ( keyword = `EXPORTING`
                                                                         name    = `rows`
                                                                         value   = `rows` )
                                                                       ( keyword = `EXPORTING`
                                                                         name    = `changed_fields`
                                                                         value   = `changed_fields` )
                                                                       ( keyword = `IMPORTING`
                                                                         name    = `failed_keys`
                                                                         value   = `engine_failed_keys` )
                                                                       ( keyword = `IMPORTING`
                                                                         name    = `messages`
                                                                         value   = `messages` ) ) ) ) )
           INTO TABLE result.

    INSERT VALUE #(
      name       = to_upper( |delete_{ subject }| )
      parameters = VALUE #( ( name      = `KEYS`
                              direction = directions-importing
                              type_name = key_table_type )
                            ( name      = `FAILED_KEYS`
                              direction = directions-exporting
                              type_name = key_table_type )
                            ( name      = `MESSAGES`
                              direction = directions-exporting
                              type_name = messages_type ) )
      source     = add_failed_keys_conversion( format_call(
                                                 call       = `engine->delete`
                                                 parameters = VALUE #( ( keyword = `EXPORTING`
                                                                         name    = `node`
                                                                         value   = node_literal )
                                                                       ( keyword = `EXPORTING`
                                                                         name    = `keys`
                                                                         value   = `CORRESPONDING #( keys )` )
                                                                       ( keyword = `IMPORTING`
                                                                         name    = `failed_keys`
                                                                         value   = `engine_failed_keys` )
                                                                       ( keyword = `IMPORTING`
                                                                         name    = `messages`
                                                                         value   = `messages` ) ) ) ) )
           INTO TABLE result.
  ENDMETHOD.


  METHOD get_association_read.
    split_member( EXPORTING name   = entry-name
                  IMPORTING node   = DATA(source_name)
                            member = DATA(association_name) ).
    DATA(association) = metadata->get_association( node = metadata->get_node( source_name )
                                                   name = association_name ).
    DATA(subject) = get_subject( entry             = entry
                                 generated_subject = to_subject( entry-name ) ).

    result = VALUE #( name       = to_upper( |read_{ subject }| )
                      parameters = VALUE #( ( name      = `KEYS`
                                              direction = directions-importing
                                              type_name = key_table_type ) ) ).
    DATA(call_parameters) = VALUE call_parameters( ( keyword = `EXPORTING`
                                                     name    = `node`
                                                     value   = |`{ source_name }`| )
                                                   ( keyword = `EXPORTING`
                                                     name    = `association`
                                                     value   = |`{ association_name }`| )
                                                   ( keyword = `EXPORTING`
                                                     name    = `keys`
                                                     value   = `CORRESPONDING #( keys )` ) ).
    " An association with parameters filters its targets, e.g. by language
    IF association-parameter_type IS BOUND.
      INSERT VALUE #( name        = `FILTER`
                      direction   = directions-importing
                      type_name   = association-parameter_type->get_relative_name( )
                      is_optional = abap_true ) INTO TABLE result-parameters.
      INSERT VALUE #( keyword = `EXPORTING`
                      name    = `filter`
                      value   = `filter` ) INTO TABLE call_parameters.
    ENDIF.
    INSERT VALUE #( name      = `RESULT`
                    direction = directions-returning
                    type_name = association-target-table_type->get_relative_name( ) ) INTO TABLE result-parameters.
    INSERT VALUE #( keyword = `IMPORTING`
                    name    = `rows`
                    value   = `result` ) INTO TABLE call_parameters.
    result-source = format_call( call       = `engine->read_by_association`
                                 parameters = call_parameters ).
  ENDMETHOD.


  METHOD get_alternative_key_read.
    split_member( EXPORTING name   = entry-name
                  IMPORTING node   = DATA(node_name)
                            member = DATA(key_name) ).
    DATA(node) = metadata->get_node( node_name ).
    DATA(alternative_key) = metadata->get_alternative_key( node = node
                                                           name = key_name ).
    DATA(subject) = get_subject( entry             = entry
                                 generated_subject = |{ to_subject( node_name ) }_by_{ to_subject( key_name ) }| ).
    result = VALUE #(
      name       = to_upper( |read_{ subject }| )
      parameters = VALUE #( ( name      = `VALUES`
                              direction = directions-importing
                              type_name = alternative_key-table_type->get_relative_name( ) )
                            ( name      = `RESULT`
                              direction = directions-returning
                              type_name = node-table_type->get_relative_name( ) ) )
      source     = format_call( call       = `engine->convert_alternative_key`
                                parameters = VALUE #( ( keyword = `EXPORTING`
                                                        name    = `node`
                                                        value   = |`{ node_name }`| )
                                                      ( keyword = `EXPORTING`
                                                        name    = `alternative_key`
                                                        value   = |`{ key_name }`| )
                                                      ( keyword = `EXPORTING`
                                                        name    = `values`
                                                        value   = `values` )
                                                      ( keyword = `IMPORTING`
                                                        name    = `rows`
                                                        value   = `result` ) ) ) ).
  ENDMETHOD.


  METHOD get_query.
    split_member( EXPORTING name   = entry-name
                  IMPORTING node   = DATA(node_name)
                            member = DATA(query_name) ).
    DATA(node) = metadata->get_node( node_name ).
    " Only checks that the query exists
    metadata->get_query_key( node = node
                             name = query_name ).
    DATA(subject) = get_subject( entry             = entry
                                 generated_subject = to_subject( query_name ) ).
    result = VALUE #(
      name       = to_upper( |query_{ subject }| )
      parameters = VALUE #( ( name        = `SELECTION_PARAMETERS`
                              direction   = directions-importing
                              type_name   = selection_parameters_type
                              is_optional = abap_true )
                            ( name        = `FILTER_KEYS`
                              direction   = directions-importing
                              type_name   = key_table_type
                              is_optional = abap_true )
                            ( name          = `MAXIMUM_ROWS`
                              direction     = directions-importing
                              type_name     = `I`
                              default_value = `0` )
                            ( name        = `SORTING`
                              direction   = directions-importing
                              type_name   = sorting_type
                              is_optional = abap_true )
                            ( name        = `PAGING`
                              direction   = directions-importing
                              type_name   = paging_type
                              is_optional = abap_true )
                            ( name      = `RESULT`
                              direction = directions-returning
                              type_name = node-table_type->get_relative_name( ) ) )
      source     = format_call( call       = `engine->query`
                                parameters = VALUE #( ( keyword = `EXPORTING`
                                                        name    = `node`
                                                        value   = |`{ node_name }`| )
                                                      ( keyword = `EXPORTING`
                                                        name    = `query`
                                                        value   = |`{ query_name }`| )
                                                      ( keyword = `EXPORTING`
                                                        name    = `selection_parameters`
                                                        value   = `selection_parameters` )
                                                      ( keyword = `EXPORTING`
                                                        name    = `filter_keys`
                                                        value   = `CORRESPONDING #( filter_keys )` )
                                                      ( keyword = `EXPORTING`
                                                        name    = `maximum_rows`
                                                        value   = `maximum_rows` )
                                                      ( keyword = `EXPORTING`
                                                        name    = `sorting`
                                                        value   = `sorting` )
                                                      ( keyword = `EXPORTING`
                                                        name    = `paging`
                                                        value   = `paging` )
                                                      ( keyword = `IMPORTING`
                                                        name    = `rows`
                                                        value   = `result` ) ) ) ).
  ENDMETHOD.


  METHOD get_action_execution.
    DATA rows_type TYPE string.

    split_member( EXPORTING name   = entry-name
                  IMPORTING node   = DATA(node_name)
                            member = DATA(action_name) ).
    DATA(action) = metadata->get_action( node = metadata->get_node( node_name )
                                         name = action_name ).
    DATA(subject) = get_subject( entry             = entry
                                 generated_subject = to_subject( action_name ) ).

    result = VALUE #( name       = to_upper( |execute_{ subject }| )
                      parameters = VALUE #( ( name        = `KEYS`
                                              direction   = directions-importing
                                              type_name   = key_table_type
                                              is_optional = abap_true ) ) ).
    DATA(call_parameters) = VALUE call_parameters( ( keyword = `EXPORTING`
                                                     name    = `node`
                                                     value   = |`{ node_name }`| )
                                                   ( keyword = `EXPORTING`
                                                     name    = `action`
                                                     value   = |`{ action_name }`| )
                                                   ( keyword = `EXPORTING`
                                                     name    = `keys`
                                                     value   = `CORRESPONDING #( keys )` ) ).
    IF action-parameter_type IS BOUND.
      INSERT VALUE #( name        = `PARAMETERS`
                      direction   = directions-importing
                      type_name   = action-parameter_type->get_relative_name( )
                      is_optional = abap_true ) INTO TABLE result-parameters.
      INSERT VALUE #( keyword = `EXPORTING`
                      name    = `parameters`
                      value   = `parameters` ) INTO TABLE call_parameters.
    ENDIF.
    IF action-result-table_type IS BOUND.
      " A result configured only by its structure has no table type name
      rows_type = action-result-table_type->get_relative_name( ).
      INSERT VALUE #( name      = `ROWS`
                      direction = directions-exporting
                      type_name = COND #( WHEN rows_type IS INITIAL THEN generic_rows_type ELSE rows_type ) )
             INTO TABLE result-parameters.
      INSERT VALUE #( keyword = `IMPORTING`
                      name    = `rows`
                      value   = `rows` ) INTO TABLE call_parameters.
    ENDIF.
    INSERT LINES OF VALUE method_parameters( ( name      = `FAILED_KEYS`
                                               direction = directions-exporting
                                               type_name = key_table_type )
                                             ( name      = `MESSAGES`
                                               direction = directions-exporting
                                               type_name = messages_type ) ) INTO TABLE result-parameters.
    INSERT LINES OF VALUE call_parameters( ( keyword = `IMPORTING`
                                             name    = `failed_keys`
                                             value   = `engine_failed_keys` )
                                           ( keyword = `IMPORTING`
                                             name    = `messages`
                                             value   = `messages` ) ) INTO TABLE call_parameters.
    result-source = add_failed_keys_conversion( format_call( call       = `engine->execute_action`
                                                             parameters = call_parameters ) ).
  ENDMETHOD.


  METHOD get_subject.
    result = COND #( WHEN entry-alias IS NOT INITIAL THEN entry-alias ELSE generated_subject ).
  ENDMETHOD.


  METHOD to_subject.
    result = to_lower( replace( val  = name
                                sub  = `.`
                                with = `_`
                                occ  = 0 ) ).
  ENDMETHOD.


  METHOD split_member.
    DATA(last_dot) = find( val = name
                           sub = `.`
                           occ = -1 ).
    node = substring( val = name
                      len = last_dot ).
    member = substring( val = name
                        off = last_dot + 1 ).
  ENDMETHOD.


  METHOD format_call.
    DATA line TYPE string.
    DATA previous_keyword TYPE string.

    " Parameter names and equal signs are aligned; the keywords EXPORTING, IMPORTING, CHANGING take ten columns
    DATA(prefix) = |    { call }( |.
    DATA(indentation) = repeat( val = ` `
                                occ = strlen( prefix ) ).
    DATA(name_width) = REDUCE i( INIT width = 0
                                 FOR parameter IN parameters
                                 NEXT width = nmax( val1 = width
                                                    val2 = strlen( parameter-name ) ) ).
    LOOP AT parameters ASSIGNING FIELD-SYMBOL(<parameter>).
      line = COND #( WHEN sy-tabix = 1 THEN prefix ELSE indentation ).
      line = line && COND string( WHEN <parameter>-keyword <> previous_keyword
                                  THEN |{ <parameter>-keyword WIDTH = 10 }|
                                  ELSE repeat( val = ` `
                                               occ = 10 ) ).
      line = |{ line }{ <parameter>-name WIDTH = name_width } = { <parameter>-value }|.
      previous_keyword = <parameter>-keyword.
      INSERT line INTO TABLE result.
    ENDLOOP.
    close_statement( CHANGING statement_lines = result ).
  ENDMETHOD.


  METHOD add_failed_keys_conversion.
    result = VALUE #( ( failed_keys_declaration )
                      ( `` )
                      ( LINES OF call_lines )
                      ( failed_keys_conversion ) ).
  ENDMETHOD.


  METHOD close_statement.
    DATA(last_index) = lines( statement_lines ).
    statement_lines[ last_index ] = |{ statement_lines[ last_index ] } ).|.
  ENDMETHOD.


  METHOD check_method_names.
    DATA names TYPE SORTED TABLE OF string WITH UNIQUE KEY table_line.

    LOOP AT checked_methods ASSIGNING FIELD-SYMBOL(<method>).
      IF strlen( <method>-name ) > maximum_name_length.
        INSERT |Method name { <method>-name } is longer than { maximum_name_length } characters; give its entry an alias|
               INTO TABLE result.
      ENDIF.
      INSERT <method>-name INTO TABLE names.
      IF sy-subrc <> 0.
        INSERT |Method name { <method>-name } is generated twice; give one of its entries an alias| INTO TABLE result.
      ENDIF.
    ENDLOOP.
  ENDMETHOD.
ENDCLASS.
